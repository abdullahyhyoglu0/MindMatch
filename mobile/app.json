{
  "expo": {
    "name": "MindMatch",
    "slug": "mindmatch-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mindmatch",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F7FB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "MindMatch sesli mesaj kaydı ve aramalar için mikrofona erişir."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Profilin ve hikâyelerin için fotoğraf seçmene izin ver.",
          "cameraPermission": "Hikâye ve profil medyası çekmek için kameraya erişim gerekir.",
          "microphonePermission": "Görüntülü görüşmelerde ses kullanmak için mikrofona erişim gerekir."
        }
      ],
      "expo-asset",
      "expo-video",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "MindMatch görüntülü görüşmelerde kameranı kullanır.",
          "microphonePermission": "MindMatch sesli ve görüntülü görüşmelerde mikrofonunu kullanır."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
