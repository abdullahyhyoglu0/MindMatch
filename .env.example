POSTGRES_PASSWORD=replace-with-a-long-random-local-password

# Cloudflare Realtime TURN credentials (configure on the API host only).
# Create a TURN key and an API token with Calls Write permission in Cloudflare.
# Never put the API token in the mobile app or commit it in an actual .env file.
Turn__Provider=Cloudflare
Turn__CloudflareTurnKeyId=replace-with-cloudflare-turn-key-id
Turn__CloudflareApiToken=replace-with-cloudflare-api-token
Turn__CredentialLifetimeSeconds=3600

